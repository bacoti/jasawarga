APP_NAME=JasaWarga
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL utama, bukan localStorage
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=jasawarga_dev
DB_USERNAME=jasawarga_app
DB_PASSWORD=
DB_SSLMODE=prefer

# Session disimpan di file Laravel selama tahap 1; migrasi table sessions belum diperlukan
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
VITE_APP_NAME=JasaWarga

# HANYA untuk pengujian lokal. TIDAK boleh true di server publik.
JASAWARGA_SEED_DEMO_ACCOUNTS=false
# Isi sendiri password kuat (min 10 karakter dengan huruf besar/kecil dan angka)
JASAWARGA_DEMO_PASSWORD=

# Tahap 2-6 modules
APP_TIMEZONE=Asia/Makassar
JASAWARGA_SERVICES_TABLE=partner_services
JASAWARGA_CATEGORIES_TABLE=service_categories
JASAWARGA_REVIEWS_TABLE=service_reviews
JASAWARGA_REPORTS_TABLE=service_complaints
